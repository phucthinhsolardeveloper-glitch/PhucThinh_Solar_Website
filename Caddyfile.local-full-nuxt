# Local full-frontend rehearsal only. Every page is Nuxt; /api/* is the Laravel API.
# Uploaded media is still read from the PHP container's volume until Laravel serves it.
#
# Run Nuxt on 127.0.0.1:3102 and Caddy on 127.0.0.1:8091.

:8091 {
	@api path /api/*
	@php_backend path /administrator /administrator/* /upload/* /thumbs/* /watermark/* /wp-content/uploads/* /robots.txt /sitemap.xml
	@php_legacy_media path_regexp legacy_media ^/assets/(?:images/site-visuals/.+\.(?:avif|gif|jpe?g|png|svg|webp)|.+\.(?:pdf|docx?|xlsx?))$
	@php_logout {
		method GET
		path /account/dang-xuat /account/dang-xuat/
	}
	@php_language_action path /ngon-ngu /ngon-ngu/

	handle @api {
		reverse_proxy host.docker.internal:8090
	}

	handle @php_backend {
		reverse_proxy host.docker.internal:8080
	}

	handle @php_legacy_media {
		reverse_proxy host.docker.internal:8080
	}

	handle @php_logout {
		reverse_proxy host.docker.internal:8080
	}

	handle @php_language_action {
		reverse_proxy host.docker.internal:8080
	}

	handle {
		reverse_proxy host.docker.internal:3102
	}
}
