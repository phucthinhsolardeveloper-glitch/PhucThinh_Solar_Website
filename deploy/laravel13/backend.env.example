# Copy to runtime/backend.env (mode 0600). Laravel only; never give this file to Nuxt.
APP_NAME="PTS Laravel"
APP_KEY=
APP_URL=http://127.0.0.1:18085
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh
SITE_CANONICAL_ORIGIN=https://phucthinhsolar.com
SESSION_DRIVER=database
SESSION_COOKIE=pts_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Phúc Thịnh Solar"
MAIL_ADMIN_TO=
ADMIN_PASSWORD_SECRET=
ADMIN_PASSWORD_SALT=
RECAPTCHA_ACTIVE=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
VNPAY_ACTIVE=0
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
ORDER_SHIPPING=true

# Nhất Tín: mock (no outbound calls) | sandbox | production (needs NTL_PRODUCTION_UNLOCKED=1 too)
NTL_MODE=mock
NTL_USERNAME=
NTL_PASSWORD=
NTL_PARTNER_ID=
NTL_WEBHOOK_TOKEN=
# 1 = checkout shows the Nhất Tín fee; 0 = area fee table / staff confirm
NTL_CHECKOUT_QUOTES=1
NTL_WRITE_OPERATIONS_ENABLED=0
NTL_LOCATION_CODES_VERIFIED=0
NTL_PRODUCTION_UNLOCKED=0
