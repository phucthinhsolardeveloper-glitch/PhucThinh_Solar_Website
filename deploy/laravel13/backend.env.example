# Copy to runtime/backend.env (mode 0600). Laravel only; never give this file to Nuxt.
APP_NAME="PTS Laravel"
APP_KEY=
APP_URL=http://127.0.0.1:18085
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Ho_Chi_Minh
SITE_CANONICAL_ORIGIN=https://phucthinhsolar.com
SESSION_DRIVER=database
SESSION_COOKIE=pts_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Phúc Thịnh Solar"
MAIL_ADMIN_TO=
ADMIN_PASSWORD_SECRET=
ADMIN_PASSWORD_SALT=
RECAPTCHA_ACTIVE=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
VNPAY_ACTIVE=0
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
ORDER_SHIPPING=true
# Four carrier adapters are still mapping_required; credentials alone do not enable quoting.
SHIPPING_GHN_ACTIVE=0
SHIPPING_GHTK_ACTIVE=0
SHIPPING_VTP_ACTIVE=0
SHIPPING_NHATTIN_ACTIVE=0
