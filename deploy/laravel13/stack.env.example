# Copy to runtime/stack.env (mode 0600). Never commit the filled file.
PTS_BACKEND_ENV=./runtime/backend.env
PTS_REHEARSAL_PORT=18085
PTS_SOURCE_REVISION=replace-with-full-git-commit-sha
PTS_BACKEND_IMAGE=pts-laravel13-backend:replace-with-commit-sha
PTS_NUXT_IMAGE=pts-laravel13-nuxt:replace-with-commit-sha
PTS_UPLOAD_DIR=./runtime/upload

DB_DATABASE=pts_laravel13_candidate
DB_USERNAME=pts_laravel13_candidate
DB_PASSWORD=
DB_ROOT_PASSWORD=
NUXT_PUBLIC_CANONICAL_SITE_ORIGIN=https://phucthinhsolar.com
TRUSTED_PROXIES=172.16.0.0/12
