:80 {
    encode zstd gzip
    header X-Robots-Tag "noindex, nofollow, noarchive"

    handle /robots.txt {
        respond 200 {
            body "User-agent: *
Disallow: /
"
        }
    }

    @laravel path /api/v1/* /admin /admin/* /livewire* /css/filament/* /js/filament/* /fonts/filament/* /upload/* /thumbs/* /health /up /sitemap.xml
    handle @laravel {
        reverse_proxy backend:80
    }

    handle {
        reverse_proxy nuxt:3000
    }
}
