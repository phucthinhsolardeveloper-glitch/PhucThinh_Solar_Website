# Sao chép thành /srv/phucthinhsolar/.env rồi chỉnh trên VPS.
# File này không chứa mật khẩu; secrets nằm trong /srv/phucthinhsolar/secrets/.
COMPOSE_PROJECT_NAME=phucthinhsolar
SITE_DOMAIN=staging.phucthinhsolar.com
# Production có thể đặt: SITE_ALIASES=", www.phucthinhsolar.com"
SITE_ALIASES=
ACME_EMAIL=website@phucthinhsolar.com
DB_NAME=phucthinhs_data
DB_USER=phucthinhs_app
TZ=Asia/Ho_Chi_Minh

# Khóa major/minor để tránh tự nhảy phiên bản ngoài kế hoạch. Sau khi pull,
# scripts/verify-stack.sh sẽ ghi digest thực tế vào báo cáo vận hành.
CADDY_IMAGE=caddy:2.10-alpine
MARIADB_IMAGE=mariadb:10.11
PTS_WEB_IMAGE=phucthinhsolar-web:bootstrap

BACKUP_RETENTION_DAYS=14
