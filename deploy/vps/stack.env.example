# Sao chép thành /srv/phucthinhsolar/.env rồi chỉnh trên VPS.
# File này không chứa mật khẩu; secrets nằm trong /srv/phucthinhsolar/secrets/.
COMPOSE_PROJECT_NAME=phucthinhsolar
SITE_DOMAIN=staging.phucthinhsolar.com
# Production có thể đặt: SITE_ALIASES=", www.phucthinhsolar.com"
SITE_ALIASES=
ACME_EMAIL=website@phucthinhsolar.com
DB_NAME=phucthinhs_data
DB_USER=phucthinhs_app
TZ=Asia/Ho_Chi_Minh

# reCAPTCHA v3. ACTIVE=0 nghĩa là form FAIL-OPEN (nhận mọi lượt gửi, không kiểm
# bot) — xem chú thích trong docker-compose.yml. Phải đặt 1 trên production.
# SITE_KEY là giá trị công khai (nằm trong HTML); secret key nằm ở
# secrets/recaptcha_secret.
RECAPTCHA_ACTIVE=1
RECAPTCHA_SITE_KEY=

# Thanh toán online — để 0/rỗng cho tới khi đã có credential và test staging.
VNPAY_ACTIVE=0
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# Vận chuyển — credential để trống cho tới khi đã đăng ký provider.
GHN_ACTIVE=0
GHN_TOKEN=
GHN_SHOP_ID=
GHTK_ACTIVE=0
GHTK_API_TOKEN=
GHTK_PARTNER_CODE=
VIETTELPOST_ACTIVE=0
VIETTELPOST_USERNAME=
VIETTELPOST_PASSWORD=
VIETTELPOST_PARTNER_ID=
NHATTIN_ACTIVE=0
NHATTIN_USERNAME=
NHATTIN_PASSWORD=
NHATTIN_PARTNER_ID=

# Kho gửi và kiện mặc định; không điền secret vào file mẫu này.
SHIPPING_ORIGIN_NAME=
SHIPPING_ORIGIN_PHONE=
SHIPPING_ORIGIN_ADDRESS=
SHIPPING_ORIGIN_CITY_CODE=
SHIPPING_ORIGIN_WARD_CODE=
SHIPPING_DEFAULT_WEIGHT_GRAMS=1000
SHIPPING_DEFAULT_LENGTH_CM=10
SHIPPING_DEFAULT_WIDTH_CM=10
SHIPPING_DEFAULT_HEIGHT_CM=10

# Khóa major/minor để tránh tự nhảy phiên bản ngoài kế hoạch. Sau khi pull,
# scripts/verify-stack.sh sẽ ghi digest thực tế vào báo cáo vận hành.
CADDY_IMAGE=caddy:2.10-alpine
MARIADB_IMAGE=mariadb:10.11
PTS_WEB_IMAGE=phucthinhsolar-web:bootstrap
PTS_NUXT_IMAGE=phucthinhsolar-nuxt:bootstrap

BACKUP_RETENTION_DAYS=14
