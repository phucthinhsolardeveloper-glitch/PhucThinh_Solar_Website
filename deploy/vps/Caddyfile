    body{min-height:100vh;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 18% 12%,rgba(37,99,235,.22),transparent 35%),radial-gradient(circle at 88% 85%,rgba(124,58,237,.2),transparent 38%),var(--bg);color:var(--text);padding:24px}
