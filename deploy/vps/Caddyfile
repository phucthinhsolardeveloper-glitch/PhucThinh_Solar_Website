{
	email {$ACME_EMAIL:admin@phucthinhsolar.com}
	{$CADDY_GLOBAL_OPTIONS:}
	servers {
		protocols h1 h2 h3
	}
}

{$SITE_DOMAIN}{$SITE_ALIASES} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# Chặn Google index bản thử.
	#
	# Matcher gắn cứng vào hostname staging, nên SAU CUTOVER nó không bao giờ
	# khớp nữa và tự vô hiệu — không có rủi ro quên tháo rồi de-index website
	# thật. Đừng đổi thành wildcard hay biến môi trường vì sẽ mất tính chất đó.
	#
	# Dùng header X-Robots-Tag thay vì chỉ sửa robots.txt: robots.txt chỉ ngăn
	# thu thập, còn URL đã biết vẫn có thể lên kết quả tìm kiếm. Header này
	# chặn ở mức từng phản hồi nên phủ mọi trang.
	@staging host staging.phucthinhsolar.com
	@staging_robots {
		host staging.phucthinhsolar.com
		path /robots.txt
	}

	# Gộp www về non-www bằng 301.
	#
	# Đo sau cutover 2026-09-17: www và non-www đều trả 200, và canonical do app
	# sinh theo HTTP_HOST nên mỗi bên tự trỏ canonical về chính nó -> toàn site
	# có hai URL trùng nội dung, chia đôi giá trị liên kết. Redirect ở tầng proxy
	# xử lý gọn hơn sửa canonical, vì nó gộp cả link equity về một URL.
	#
	# Hostname để cứng có chủ ý: host matcher của Caddy chỉ cho wildcard ở nhãn
	# ngoài cùng (*.domain), không có dạng www.* nên không viết tổng quát được.
	@www host www.phucthinhsolar.com

	route {
		redir @www https://phucthinhsolar.com{uri} permanent

		header @staging X-Robots-Tag "noindex, nofollow, noarchive"
		respond @staging_robots 200 {
			body "User-agent: *
Disallow: /
"
		}

		# health_uri để /robots.txt là CỐ Ý, khác với healthcheck của container
		# web (xem chú thích trong docker-compose.yml). Đây là phép thử "Apache
		# còn trả lời không" để Caddy quyết định có route hay không; nếu siết
		# thành GET / đòi 200 thì khi PHP lỗi Caddy sẽ trả 502 và che mất thông
		# báo lỗi thật, khó chẩn đoán hơn. Cổng gác deploy/rollback là
		# healthcheck của container, không phải chỗ này.
		@nuxt_hybrid_cutover {
			expression `{env.PTS_NUXT_HYBRID_ENABLED} == "1"`
			not path /api/* /administrator /administrator/* /upload/* /thumbs/* /watermark/* /wp-content/uploads/* /robots.txt /sitemap.xml /account/* /ngon-ngu /ngon-ngu/* /migration-*
			not path_regexp legacy_media ^/assets/(?:images/site-visuals/.+\.(?:avif|gif|jpe?g|png|svg|webp)|.+\.(?:pdf|docx?|xlsx?))$
			not {
				method POST
				path /gio-hang /gio-hang/*
			}
		}

		handle @nuxt_hybrid_cutover {
			reverse_proxy nuxt:3000 {
				health_uri /_migration/site
				health_interval 30s
				health_timeout 5s
			}
		}

		reverse_proxy web:80 {
			health_uri /robots.txt
			health_interval 30s
			health_timeout 5s
		}
	}
}

